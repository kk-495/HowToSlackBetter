/* 启动弹窗。组件样式与 app.wxss 隔离,配色与图标在这里自带一份,
   值取自设计令牌「慢水 / Slow Water」(见 app.wxss 顶部变量块)。 */

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  background: rgba(13, 34, 50, 0.58);
}

.stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-height: 100%;
}

/* ---- 卡片模式 ---- */
/* v3:深海蓝品牌色,与全站「慢水」体系一致;淡蓝对角渐变是水面暗示 */

.card {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx 40rpx 40rpx;
  background: linear-gradient(225deg, #DCE9F3 0%, #FFFFFF 45%, #EFF4F9 72%, #DFEBF3 100%);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(27, 27, 31, 0.22);
}

.kicker {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #727277;
}

/* 品牌头像:圆形,替代原 tick 方块 —— 开篇第一眼就是品牌记忆 */
.brand {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  flex: none;
  background: #E8EDF2;
}

.headline {
  margin-top: 28rpx;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.01em;
  color: #1B1B1F;
}

.headline .em {
  color: #1E5A8A;
}

.sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #66666C;
  word-break: normal;
  overflow-wrap: break-word;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

.tag {
  min-height: 52rpx;
  display: inline-flex;
  align-items: center;
  margin: 0 12rpx 12rpx 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

/* ---- 位图模式 ---- */

.pic {
  display: block;
  border-radius: 20rpx;
  background: #FFFFFF;
}

/* ---- 关闭按钮放在内容下方,不遮挡内容 ---- */

.close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-top: 32rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  color: #FFFFFF;
}

.close:active {
  background: rgba(255, 255, 255, 0.18);
}

.ic-x {
  position: relative;
  display: block;
  width: 32rpx;
  height: 32rpx;
  color: currentColor;
}

.ic-x::before,
.ic-x::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.ic-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.ic-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 刻意不做深色模式改写:开篇卡是浅色水面质感,深色系统下遮罩够暗、卡片自发光,
   保持与浅色一致的品牌记忆。 */

/* 点击反馈:公告图可点跳转时压暗。遮罩不加 —— 点遮罩的反馈就是弹窗关闭本身 */
.pic:active {
  opacity: 0.92;
}

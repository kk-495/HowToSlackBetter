/* 自定义 tabBar:纯 WXSS,零图片资源。
   组件样式默认与 app.wxss 隔离,所以配色与图标在这里自带一份,
   不依赖 CSS 变量穿透;深色模式在组件内单独声明。 */

.tabbar {
  --tb-bg: #FFFFFF;
  --tb-border: #E9E2D6;
  --tb-text: #635B50;
  --tb-active: #2E6B4C;

  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  background: var(--tb-bg);
  border-top: 1rpx solid var(--tb-border);
  padding-bottom: env(safe-area-inset-bottom);
}

@media (prefers-color-scheme: dark) {
  .tabbar {
    --tb-bg: #262220;
    --tb-border: #3A3430;
    --tb-text: #B6AC9F;
    --tb-active: #5FA47C;
  }
}

.tab {
  position: relative;
  flex: 1;
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 8rpx;
  color: var(--tb-text);
}

.tab.on {
  color: var(--tb-active);
}

/* 激活指示:顶部 48rpx 短横条 */
.tab.on::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 48rpx;
  height: 4rpx;
  background: var(--tb-active);
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.tab-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---- 图标(与 app.wxss 同款几何语言:3rpx 线宽 / currentColor) ---- */

.ic {
  position: relative;
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  flex: none;
  color: currentColor;
}

.ic-book::before {
  content: '';
  position: absolute;
  left: 3rpx;
  top: 4rpx;
  width: 26rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.ic-book::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 4rpx;
  width: 3rpx;
  height: 24rpx;
  background: currentColor;
}

.ic-info::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.ic-info::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.ic-star::before {
  content: '☆';
  position: absolute;
  left: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  text-align: center;
}

.ic-star.on::before {
  content: '★';
}

/* 点击反馈:tab 按下时轻微压暗(激活态由 .on 负责,两者不冲突) */
.tab:active {
  opacity: 0.7;
}

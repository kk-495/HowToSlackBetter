<!-- 关于页:编辑体版式,不再用卡片堆叠
     每块内容用眉标 + 发丝线分隔,和全书的编辑语言统一 -->
<view class="wrap">
  <!-- 页头:直接落纸面,小鱼是全站品牌签名 -->
  <view class="about-head">
    <view class="kicker about-kicker"><view class="fish"><view class="eye"></view></view><text>关于</text></view>
    <view class="ah-title">关于本小程序</view>
    <view class="ah-sub">
      本工具把开源项目《高性价比摸鱼指南》的全部 {{count}} 条建议、{{sectionCount}} 个章节，整理成可搜索、可收藏的摸鱼手册。内容以 CC BY 4.0 授权发布，转载请保留出处。
    </view>
  </view>

  <view class="wave-hair about-hair"></view>

  <!-- 特点:用项目符号 + 扁平行,不用卡片外壳 -->
  <view class="about-sec">
    <view class="kicker"><view class="tick"></view>特点</view>
    <view class="feat-list">
      <view class="feat-row">
        <view class="feat-dot"></view>
        <view class="feat-body">
          <view class="feat-t">零后端、零网络</view>
          <view class="feat-m">所有内容随包安装，断网也能用</view>
        </view>
      </view>
      <view class="feat-row">
        <view class="feat-dot"></view>
        <view class="feat-body">
          <view class="feat-t">不收集任何个人信息</view>
          <view class="feat-m">不需要登录，不需要授权</view>
        </view>
      </view>
      <view class="feat-row">
        <view class="feat-dot"></view>
        <view class="feat-body">
          <view class="feat-t">只存在你自己手机里</view>
          <view class="feat-m">收藏与阅读记录都在本地，不上传</view>
        </view>
      </view>
    </view>
  </view>

  <view class="hair about-hair"></view>

  <!-- 怎么看这些内容:证据等级解释是建立信任的关键,单独给足分量 -->
  <view class="about-sec">
    <view class="kicker"><view class="tick"></view>怎么看</view>
    <view class="how-title">证据等级是什么意思</view>

    <view class="lv-row">
      <text class="lv-badge a">A</text>
      <view class="lv-body">
        <view class="lv-t">有研究或官方数据支撑</view>
        <view class="lv-m">结论最硬，优先采纳</view>
      </view>
    </view>
    <view class="lv-row">
      <text class="lv-badge b">B</text>
      <view class="lv-body">
        <view class="lv-t">有专家共识</view>
        <view class="lv-m">但硬证据一般，值得参考</view>
      </view>
    </view>
    <view class="lv-row">
      <text class="lv-badge c">C</text>
      <view class="lv-body">
        <view class="lv-t">有道理</view>
        <view class="lv-m">但缺少硬证据，自己判断</view>
      </view>
    </view>

    <view class="how-block">
      <view class="how-label">来源怎么查</view>
      <view class="how-body">
        每条建议都附了原始出处（机构 + 链接）。详情页点一下即可复制链接，在浏览器里打开自己核对。
      </view>
    </view>
  </view>

  <view class="hair about-hair"></view>

  <!-- 免责声明:沿用说人话块,产品签名 -->
  <view class="plain big">
    <view class="p-head">免责声明</view>
    本工具仅对公开开源内容做整理排版，不构成医疗、投资、法律或其他专业建议。涉及健康、金钱、法律的决策请以专业人士与权威部门信息为准。
  </view>

  <!-- 数据来源:两份开源项目分别署名(CC BY 4.0 要求转载注明出处) -->
  <view class="about-sec">
    <view class="kicker"><view class="tick"></view>数据</view>
    <view class="src-title">开源项目地址</view>
    <view class="src-line" wx:for="{{meta.sources}}" wx:key="name">
      <view class="src-name">《{{item.name}}》 · {{item.license}}</view>
      <text class="src-url" user-select>{{item.url}}</text>
    </view>
  </view>

  <view class="footer">
    内容源自开源项目《高性价比摸鱼指南》(CC BY 4.0)<br/>仅作整理展示 · 不构成专业建议
  </view>
</view>

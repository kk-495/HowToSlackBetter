/* 发现(tabBar 页):先看这几条 Top 10 + 今天再看两条
   头部用大 "Top 10" 作为视觉锚点,底部说明用编辑体风格
   扁平行 / 编辑线 / 序号等结构样式在 app.wxss,这里只管本页的边距与页头 */

.wrap {
  padding-top: var(--space-6);
}

.head {
  padding: 0 var(--page-gutter) var(--space-section);
  position: relative;
}

/* Top 10 大数字:像杂志封面的标题处理
   陶土色淡印在右上角,既是装饰也是"这是一个特别清单"的信号 */
.top-num {
  position: absolute;
  right: var(--page-gutter);
  top: 0;
  font-size: 140rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-mark);
  opacity: 0.08;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}

.h-title {
  margin-top: var(--space-3);
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-primary);
  position: relative;
  z-index: 1;
}

.h-sub {
  margin-top: var(--space-4);
  font-size: var(--fs-meta);
  line-height: 1.75;
  color: var(--color-text-secondary);
  word-break: normal;
  overflow-wrap: break-word;
  position: relative;
  z-index: 1;
}

.ed-pick {
  margin: 0 var(--page-gutter);
}

.more-list {
  margin: var(--space-2) var(--page-gutter) 0;
  border-top: 1rpx solid var(--color-rule);
}

/* 底部编者按:像杂志末尾的编辑说明
   用发丝线框起来,眉标 + 正文,和全书编辑语言统一 */
.foot-note {
  margin: var(--space-section) var(--page-gutter) 0;
  padding: var(--space-5) 0;
  border-top: 1rpx solid var(--color-rule);
  border-bottom: 1rpx solid var(--color-rule);
}

.foot-note .kicker {
  margin-bottom: var(--space-3);
}

.foot-text {
  font-size: var(--fs-meta);
  line-height: 1.75;
  color: var(--color-text-secondary);
  word-break: normal;
  overflow-wrap: break-word;
}

<!-- 发现(tabBar 页):先看这几条 Top 10 + 今天再看两条
     头部用大 "Top 10" 作为视觉锚点,底部说明用编辑体风格 -->
<view class="wrap with-tabbar">
  <view class="head">
    <view class="kicker"><view class="tick"></view>发现 · 编辑推荐</view>
    <view class="top-num">Top {{n}}</view>
    <view class="h-title">先看这几条</view>
    <view class="h-sub">
      全库 {{total}} 条 A 级证据。
      这里按证据等级从中挑了 {{n}} 条，每章最多一条，尽量覆盖不同的工作场景。
    </view>
  </view>

  <view class="ed-pick">
    <view
      class="ed-row"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="ed-num">{{item.no}}</view>
      <view class="ed-body">
        <view class="ed-t">{{item.title}}</view>
        <view class="ed-m">{{item.section}} · 证据 {{item.level}} · {{item.sourceCount}} 条来源</view>
      </view>
    </view>
  </view>

  <view class="act-head">
    <text class="zh">今天再看两条</text>
    <text class="en">Today</text>
  </view>
  <view class="more-list" wx:if="{{dailyMore.length}}">
    <view
      class="more-row"
      wx:for="{{dailyMore}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="mr-body">
        <view class="mr-title">{{item.title}}</view>
        <view class="mr-sub">{{item.section}} · {{item.level}} 级证据</view>
      </view>
    </view>
  </view>

  <!-- 底部说明:用发丝线 + 眉标,像杂志的编者按 -->
  <view class="foot-note">
    <view class="kicker"><view class="tick"></view>编者按</view>
    <view class="foot-text">
      筛选与排序全部来自上游的证据等级，不是我们挑的。每一条为什么排在这里，点开就能看到它的依据和出处。
    </view>
  </view>
</view>

/* 章节页:大序号 + 编辑体标题
   章节号是全书的骨架,在页头给足视觉分量,让用户知道自己在哪
   非 tabBar 页,返回由原生导航栏提供 */

.wrap {
  padding-top: var(--space-5);
}

.sec-head {
  padding: 0 var(--page-gutter) var(--space-6);
  position: relative;
}

/* 超大序号:像书的章节页,用陶土色,半透明叠在标题后面
   —— 既是装饰也是定位信号 */
.sec-num {
  position: absolute;
  right: var(--page-gutter);
  top: 0;
  font-size: 160rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-mark);
  opacity: 0.08;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}

.sec-title {
  margin-top: var(--space-4);
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-primary);
  word-break: normal;
  overflow-wrap: break-word;
  position: relative;
  z-index: 1;
}

.sec-sub {
  margin-top: var(--space-3);
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
  position: relative;
  z-index: 1;
}

/* 扁平行 + 发丝线(行结构在 app.wxss) */
.ed-list {
  margin: 0 var(--page-gutter);
}

/* 本页不是 tabBar 页,没有底部 tabBar 要避让,回顶按钮贴底就行 */
.to-top {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

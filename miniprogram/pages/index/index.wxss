/* 首页:三幕式(今日 / 新手必看 / 怎么找)+ 搜索面板
   版式规则:列表一律「扁平行 + 发丝线」,全页只有 .hero 一个浮起元素 */

.topbar {
  position: relative;
  z-index: 60;
  padding: var(--space-4) 0 var(--space-2);
  background: var(--color-bg);
}

.search-wrap {
  position: relative;
}

.searchbox {
  display: flex;
  align-items: center;
  margin: 0 var(--page-gutter);
  padding: 0 var(--space-5);
  height: 80rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-placeholder);
}

.search-input {
  flex: 1;
  height: 80rpx;
  margin-left: var(--space-3);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}

.search-ph {
  color: var(--color-text-placeholder);
}

/* ---- 搜索聚焦面板:最近搜索 + 试试这些(唯一浮起的弹层) ---- */

.search-panel {
  position: absolute;
  left: var(--page-gutter);
  right: var(--page-gutter);
  top: 88rpx;
  padding: var(--space-4) var(--space-5) var(--space-2);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-hero);
}

.sp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  font-size: var(--fs-micro);
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}

.sp-clear {
  padding: 0 var(--space-2);
  font-size: var(--fs-micro);
  color: var(--color-primary);
}

.sp-chips {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: var(--space-2);
}

.search-panel .chip {
  padding: 0 var(--space-2) 0 var(--space-4);
  color: var(--color-text-primary);
}

/* 历史胶囊右侧的删除叉。
   热区做到 56x56rpx(28x28px),原来只有 22rpx(11px),太容易点空或被误判成点整条 */
.sp-word {
  margin-right: var(--space-1);
}

.ic.sp-del {
  width: 56rpx;
  height: 56rpx;
  margin-left: var(--space-1);
  color: var(--color-text-placeholder);
}

.ic.sp-del::before,
.ic.sp-del::after {
  width: 18rpx;
  height: 3rpx;
}

/* 热词:主色浅底,和中性色的历史胶囊区分开 */
.chip-hot {
  background: var(--color-primary-soft);
  border-color: var(--color-primary-soft);
  color: var(--color-primary);
}

/* 筛选与导航已解耦:这一排只放筛选,导航收进 tabBar */
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-2) var(--page-gutter) 0;
}

.c-count {
  padding: var(--space-2) var(--page-gutter) var(--space-4);
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

/* 结果太宽泛时的提示 */
.c-hint {
  margin: calc(-1 * var(--space-3)) var(--page-gutter) var(--space-3);
  font-size: var(--fs-meta);
  line-height: 1.6;
  color: var(--color-secondary-ink);
}

/* ---- 信任条:护城河(1713 条来源)从页脚提到首屏 ---- */

.trust-line {
  padding: var(--space-3) var(--page-gutter) var(--space-2);
  font-size: var(--fs-micro);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.trust-line .tl-strong {
  font-weight: 600;
  color: var(--color-text-primary);
}

.trust-line .tl-dot {
  margin: 0 var(--space-2);
  color: var(--color-border-strong);
}

/* ---- 幕一 · 今日一条 ---- */

.hero .t-title {
  margin-top: var(--space-3);
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.32;
  color: var(--color-text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hero .meta {
  margin-top: var(--space-3);
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

.hero .meta .dot {
  margin: 0 var(--space-2);
  color: var(--color-border-strong);
}

.hero .cost {
  margin-top: var(--space-1);
  font-size: var(--fs-meta);
  color: var(--color-mark-ink);
}

/* 分享入口。
   小程序 <button> 的宽度极难约束(默认 display:block + margin:auto + overflow:hidden,
   连 flex:none 和 position:absolute 都试过,真机上仍会被撑成一条空心长胶囊)。
   所以把「长什么样」和「能点」拆开:
     .share-visual —— 普通 <view>,负责全部外观
     .share-hit    —— 透明的 <button>,绝对定位盖在上面,只负责 open-type="share"
   这样按钮怎么渲染都影响不到布局。 */
.share-slot {
  position: relative;
  flex: none;
  width: 176rpx;
  height: 52rpx;
  margin-right: var(--space-4);
}

.share-visual {
  position: absolute;
  left: 0;
  top: 0;
  width: 176rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: var(--fs-meta);
  font-weight: 600;
  line-height: 1;
  color: var(--color-primary);
}

.share-visual .ic {
  margin-right: var(--space-1);
}

.share-hit {
  position: absolute;
  left: 0;
  top: 50%;
  width: 176rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  opacity: 0;
  border: none;
  background: transparent;
  transform: translateY(-50%);
}

.share-hit::after {
  border: none;
}

/* 卡片底部动作行:分享(文字)+ 换一条(唯一主按钮),右对齐、同一基线 */
.t-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: var(--space-5);
  padding-top: var(--space-4);
  border-top: 1rpx solid var(--color-rule);
}

.btn-shuffle {
  position: relative;
  flex: none;
  height: 52rpx;
  padding: 0 var(--space-5);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-radius: var(--radius-pill);
  font-size: var(--fs-meta);
  font-weight: 600;
}

/* 视觉高 52rpx,热区撑到 88rpx */
.btn-shuffle::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.btn-shuffle:active {
  background: var(--color-primary-strong);
}

/* ---- 今天再看两条:无卡壳,直接接在今日卡下面(结构样式在 app.wxss) ---- */

.more-list {
  margin: var(--space-5) var(--page-gutter) 0;
  border-top: 1rpx solid var(--color-rule);
}

/* ---- 幕二 · 编辑推荐(编辑线 / 序号 / 行结构在 app.wxss) ---- */

.ed-pick {
  margin: 0 var(--page-gutter);
}

.ed-more {
  margin: var(--space-2) var(--page-gutter) 0;
}

/* ---- 搜索结果:同样是扁平行 + 发丝线 ---- */

.ed-list {
  margin: 0 var(--page-gutter);
}

/* ---- 幕三 · 怎么找 ---- */

.find-group {
  margin: 0 var(--page-gutter);
}

.find-line {
  display: flex;
  align-items: baseline;
  padding: var(--space-3) 0 var(--space-2);
}

.find-line .lbl {
  flex: none;
  font-size: var(--fs-meta);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--color-mark-ink);
}

.find-line .sep {
  margin: 0 var(--space-3);
  color: var(--color-border-strong);
}

.find-line .lbl2 {
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

.find-line .en-mini {
  margin-left: var(--space-3);
  font-size: var(--fs-micro);
  letter-spacing: 0.06em;
  color: var(--color-text-placeholder);
}

.tag-scroll {
  white-space: nowrap;
  padding: var(--space-1) 0;
}

.tag-chip {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 var(--space-5);
  margin-right: var(--space-3);
  background: transparent;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: var(--fs-meta);
  color: var(--color-text-primary);
}

.tag-chip:active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary-soft);
  color: var(--color-primary);
}

.tag-chip-stage {
  color: var(--color-text-secondary);
}

/* 章节:去卡片外壳,序号用陶土色两位补零 */
.find-chapters {
  margin-top: var(--space-6);
}

.sec-list {
  border-top: 1rpx solid var(--color-rule);
}

.sec-item {
  display: flex;
  align-items: baseline;
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--color-rule);
}

.sec-item:active {
  background: var(--color-surface-2);
}

.cn {
  flex: none;
  width: 60rpx;
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-mark);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}

.sb {
  flex: 1;
  min-width: 0;
}

.st {
  font-size: var(--fs-body);
  line-height: 1.45;
  color: var(--color-text-primary);
}

.sc {
  margin-top: var(--space-1);
  font-size: var(--fs-micro);
  color: var(--color-text-secondary);
}

/* ---- 最近在看:横向滑动的卡片(标题动辄 20 多字,胶囊只能看到前半句) ---- */

.recent-scroll {
  white-space: nowrap;
  padding: var(--space-2) 0 var(--space-3);
}

.recent-card {
  display: inline-block;
  vertical-align: top;
  width: 400rpx;
  margin-left: var(--page-gutter);
  padding: var(--space-4);
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  white-space: normal;
}

.recent-card:last-child {
  margin-right: var(--page-gutter);
}

.rc-title {
  font-size: var(--fs-meta);
  line-height: 1.5;
  color: var(--color-text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.rc-sub {
  margin-top: var(--space-2);
  font-size: var(--fs-micro);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-title {
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

/* 搜不到时给可点的热词,而不是只写一串文字 */
.empty-hot {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-4);
  padding: 0 var(--page-gutter);
}

/* ===================================================================
   点击反馈(本页可点的元素)
   按下即现、松开即还原,纯视图层 :active,不用 JS 延时
   =================================================================== */

/* 唯一浮起卡:弱反馈 */
.hero:active {
  opacity: 0.92;
}

/* 文字链接类 */
.link:active,
.sp-clear:active {
  opacity: 0.7;
}

/* 分享是「view 管外观 + 透明 button 管点击」,
   反馈必须挂在容器上 —— 透明按钮本身没有可看的视觉 */
.share-slot:active .share-visual {
  opacity: 0.7;
}

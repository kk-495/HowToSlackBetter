/* 我的(tabBar 页):收藏 + 搜索/排序 + 关于入口
   头部用大数字突出收藏数,让用户有"攒了东西"的成就感 */

.wrap {
  padding-top: var(--space-6);
}

.mine-head {
  padding: 0 var(--page-gutter) var(--space-5);
  position: relative;
}

/* 大数字:收藏数作为头部视觉锚点
   陶土色淡印,既是装饰也是成就感 */
.m-num {
  position: absolute;
  right: var(--page-gutter);
  top: 0;
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-mark);
  opacity: 0.08;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}

.m-title {
  margin-top: var(--space-3);
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-primary);
  position: relative;
  z-index: 1;
}

.m-sub {
  margin-top: var(--space-3);
  font-size: var(--fs-meta);
  line-height: 1.6;
  color: var(--color-text-secondary);
  position: relative;
  z-index: 1;
}

.fav-bar {
  padding-top: var(--space-1);
}

.searchbox {
  display: flex;
  align-items: center;
  margin: 0 var(--page-gutter);
  padding: 0 var(--space-5);
  height: 80rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-placeholder);
}

.search-input {
  flex: 1;
  height: 80rpx;
  margin-left: var(--space-3);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}

.search-ph {
  color: var(--color-text-placeholder);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-3) var(--page-gutter) 0;
}

.c-count {
  padding: var(--space-4) var(--page-gutter) var(--space-3);
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

/* 扁平行 + 发丝线(行结构在 app.wxss) */
.ed-list {
  margin: 0 var(--page-gutter);
}

/* ---- 空态 ---- */

.empty-star {
  font-size: 88rpx;
  line-height: 1;
  text-align: center;
  margin-bottom: var(--space-5);
  color: var(--color-text-placeholder);
  font-weight: 300;
}

.ic.big-search {
  display: block;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--space-5);
  color: var(--color-text-placeholder);
}

.ic.big-search::before {
  left: 5rpx;
  top: 5rpx;
  width: 58rpx;
  height: 58rpx;
  border-width: 5rpx;
}

.ic.big-search::after {
  right: 8rpx;
  bottom: 9rpx;
  width: 28rpx;
  height: 5rpx;
}

/* .empty-title / .empty-btn 是公共样式,在 app.wxss 里 */

/* ---- 分享我的收藏 ---- */

.share-row {
  padding: var(--space-6) var(--space-4) 0;
}

.share-row .btn {
  margin: 0 var(--space-2);
}

.share-row .ic {
  margin-right: var(--space-2);
}

/* ---- 关于入口:编辑体风格 ---- */

.about-entry {
  display: flex;
  align-items: center;
  margin: var(--space-section) var(--page-gutter) 0;
  padding: var(--space-4) 0;
  border-top: 1rpx solid var(--color-rule);
  border-bottom: 1rpx solid var(--color-rule);
}

.about-entry:active {
  background: var(--color-surface-2);
}

/* 反馈块:公众号二维码。手机上不能扫自己的屏幕,交互是
   点图放大(wx.previewImage),再长按识别(show-menu-by-longtap),关注后发私信 */
.fb-block {
  margin: var(--space-section) var(--page-gutter) 0;
  padding: var(--space-4) 0;
  border-top: 1rpx solid var(--color-rule);
  border-bottom: 1rpx solid var(--color-rule);
}

.fb-head {
  margin-top: var(--space-2);
}

.fb-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.fb-m {
  margin-top: var(--space-1);
  font-size: var(--fs-micro);
  color: var(--color-text-secondary);
}

.fb-qr {
  display: block;
  width: 100%;
  margin-top: var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
}

.fb-qr:active {
  opacity: 0.85;
}

.about-entry-left {
  flex: 1;
  min-width: 0;
}

.about-entry-left .kicker {
  margin-bottom: var(--space-2);
}

.ae-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.ae-m {
  margin-top: var(--space-1);
  font-size: var(--fs-micro);
  color: var(--color-text-secondary);
}

.about-entry .ic {
  flex: none;
  margin-left: var(--space-3);
  color: var(--color-text-tertiary);
}

/* 我的(tabBar 页):收藏 + 搜索/排序 + 关于入口 */

.wrap {
  padding-top: var(--space-6);
}

.mine-head {
  padding: 0 var(--page-gutter) var(--space-5);
}

.m-title {
  margin-top: var(--space-3);
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-text-primary);
}

.m-sub {
  margin-top: var(--space-3);
  font-size: var(--fs-meta);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.fav-bar {
  padding-top: var(--space-1);
}

.searchbox {
  display: flex;
  align-items: center;
  margin: 0 var(--page-gutter);
  padding: 0 var(--space-5);
  height: 80rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-placeholder);
}

.search-input {
  flex: 1;
  height: 80rpx;
  margin-left: var(--space-3);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}

.search-ph {
  color: var(--color-text-placeholder);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-3) var(--page-gutter) 0;
}

.c-count {
  padding: var(--space-4) var(--page-gutter) var(--space-3);
  font-size: var(--fs-meta);
  color: var(--color-text-secondary);
}

/* 扁平行 + 发丝线(行结构在 app.wxss) */
.ed-list {
  margin: 0 var(--page-gutter);
}

/* ---- 空态 ---- */

.ic.big-star {
  display: block;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--space-5);
  color: var(--color-text-placeholder);
}

.ic.big-star::before {
  width: 88rpx;
  height: 88rpx;
  font-size: 88rpx;
  line-height: 88rpx;
}

.ic.big-search {
  display: block;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--space-5);
  color: var(--color-text-placeholder);
}

.ic.big-search::before {
  left: 5rpx;
  top: 5rpx;
  width: 58rpx;
  height: 58rpx;
  border-width: 5rpx;
}

.ic.big-search::after {
  right: 8rpx;
  bottom: 9rpx;
  width: 28rpx;
  height: 5rpx;
}

/* .empty-title / .empty-btn 是公共样式,在 app.wxss 里 */

/* ---- 分享我的收藏 ---- */

.share-row {
  padding: var(--space-6) var(--space-4) 0;
}

.share-row .btn {
  margin: 0 var(--space-2);
}

.share-row .ic {
  margin-right: var(--space-2);
}

/* ---- 关于(降级成一行) ---- */

.link-row {
  display: flex;
  align-items: center;
  margin: var(--space-7) var(--page-gutter) 0;
  padding: var(--space-4) 0;
  border-top: 1rpx solid var(--color-rule);
  border-bottom: 1rpx solid var(--color-rule);
}

.link-row:active {
  background: var(--color-surface-2);
}

.lk-body {
  flex: 1;
  min-width: 0;
}

.lk-t {
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}

.lk-m {
  margin-top: var(--space-1);
  font-size: var(--fs-micro);
  color: var(--color-text-secondary);
}
